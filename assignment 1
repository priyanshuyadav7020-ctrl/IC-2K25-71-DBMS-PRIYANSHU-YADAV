   country_id varchar(2),
   country_name varchar(40),
   region_id decimal(10,0)
);

Q2)
CREATE TABLE IF NOT EXISTS countries (
   country_id varchar(2),
   country_name varchar(40),
   region_id decimal(10,0)
);

Q3)
CREATE TABLE dup_countries LIKE countries;

Q4)
CREATE TABLE dup_countries AS
SELECT * FROM countries;

Q5)
CREATE TABLE countries (
   country_id varchar(2) NULL,
   country_name varchar(40) NULL,
   region_id decimal(10,0) NULL
);

Q6)
CREATE TABLE jobs (
   job_id varchar(10),
   job_title varchar(35),
   min_salary decimal(6,0),
   max_salary decimal(6,0) CHECK(max_salary <= 25000)
);

Q7)
CREATE TABLE countries (
   country_id varchar(2),
   country_name varchar(40) CHECK(country_name IN ('Italy', 'India', 'China')),
   region_id decimal(10,0)
);

Q8)
CREATE TABLE job_histry (
   employee_id decimal(6,0),
   start_date date,
   end_date varchar(10) CHECK (end_date LIKE '__/__/____'),
   job_id varchar(10),
   department_id decimal(4,0)
);